# ============================================================================
# REPLICATE API - Required for AI models (virtual try-on, background swap)
# Get your token from: https://replicate.com/account/api-tokens
# ============================================================================
REPLICATE_API_TOKEN=your_replicate_api_token_here

# ============================================================================
# JWT AUTHENTICATION - MUST be changed in production
# Generate a secure key: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ============================================================================
JWT_SECRET_KEY=your-secure-jwt-secret-key-change-this-in-production

# ============================================================================
# DATABASE - SQLite for development, PostgreSQL recommended for production
# Development: sqlite:///./fashion.db
# Production: postgresql://user:password@localhost/fashion_db
# ============================================================================
DATABASE_URL=sqlite:///./fashion.db

# ============================================================================
# JWT TOKEN EXPIRATION (in minutes)
# ============================================================================
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ============================================================================
# AGE VERIFICATION SERVICE
# Options: "mock" (for development), "yoti", "idology", "jumio", "custom"
# For production, integrate with a real age verification provider
# ============================================================================
AGE_VERIFICATION_SERVICE=mock
AGE_VERIFICATION_API_KEY=mock_key_for_development

# ============================================================================
# FILE UPLOAD LIMITS
# ============================================================================
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ============================================================================
# RATE LIMITING
# Format: requests_per_period (e.g., "5/minute", "100/hour")
# ============================================================================
RATE_LIMIT_TRY_ON=5/minute
RATE_LIMIT_AUTH=10/hour
RATE_LIMIT_UPLOAD=20/hour

# ============================================================================
# LOGGING
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# Comma-separated list of allowed origins
# Development: http://localhost:3000,http://localhost:8080
# Production: https://yourdomain.com,https://www.yourdomain.com
# ============================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:3000

# ============================================================================
# ENVIRONMENT
# Options: development, staging, production
# ============================================================================
ENVIRONMENT=development

# ============================================================================
# SECURITY
# ============================================================================
# Enable HTTPS redirect (set to true in production)
HTTPS_ONLY=false

# Security headers
SECURE_COOKIES=false

# ============================================================================
# STORAGE - For persisting generated images
# Options: local, s3, gcs
# ============================================================================
STORAGE_TYPE=local
STORAGE_PATH=./generated_images

# AWS S3 Configuration (if using S3)
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret
# AWS_S3_BUCKET=your_bucket
# AWS_S3_REGION=us-east-1

# ============================================================================
# NUDENET & MEDIAPIPE MODELS
# Skip download if already cached
# ============================================================================
NUDENET_MODEL_PATH=./models/nudenet
MEDIAPIPE_MODEL_PATH=./models/mediapipe

# ============================================================================
# GARMENT CATALOG - Can be loaded from S3 or local
# ============================================================================
GARMENT_CATALOG_SOURCE=database  # options: database, s3, local
GARMENT_CATALOG_PATH=./garments
